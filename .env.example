# Copy to .env (git-ignored) and fill in. Never commit real values.
VIPER_APP_ENV=dev
VIPER_LOG_LEVEL=INFO
# Hybrid-plane settings are added here once config.py is finalized.
VIPER_OLLAMA_HOST=http://localhost:11434
VIPER_OLLAMA_MODEL=
VIPER_QDRANT_PATH=data/qdrant
VIPER_EXEC_API_URL=
VIPER_EXEC_API_TOKEN=
VIPER_ALLOW_ACTIVE_TESTING=false
VIPER_EMBED_MODEL=nomic-embed-text
VIPER_KB_VERSION=v2p
VIPER_RETRIEVAL_TOP_K=4
VIPER_MIN_SCORE=0.65
# Embedding task prefixes default to nomic-embed-text values in code; do not set here (.env strips trailing spaces).
